# Server secrets. Never use VITE_ or NEXT_PUBLIC_ for credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
APP_URL=http://localhost:5173
API_PORT=3000
# Explicit local fixture mode; always rejected in production / Vercel.
DEMO_MODE=true
AI_DAILY_REQUEST_LIMIT=60
AI_DAILY_TOKEN_LIMIT=25000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Comma-separated Chrome extension IDs allowed to call the production API.
EXTENSION_IDS=

# Optional separate production origin while APP_URL stays local for development.
PRODUCTION_APP_URL=
